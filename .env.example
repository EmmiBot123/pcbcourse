# AronLabz Tech Pvt Ltd - Razorpay Gateway Configuration
# Copy this file to .env.local to activate live Razorpay transactions

# Razorpay Key ID (Get from https://dashboard.razorpay.com/app/keys)
# Starts with rzp_test_... (for test mode) or rzp_live_... (for live payments)
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyHere
