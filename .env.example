# ============================================================
# AronLabz Tech Pvt Ltd - Payment & Email Automation Config
# ============================================================

# 1. Razorpay Gateway Keys (https://dashboard.razorpay.com/app/keys)
# Starts with rzp_test_... for test mode, or rzp_live_... for production
VITE_RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyHere

# 2. EmailJS Automated Confirmation Keys (https://dashboard.emailjs.com)
# Service ID (from EmailJS -> Email Services, e.g. Gmail)
VITE_EMAILJS_SERVICE_ID=service_your_id

# Template ID for Student Welcome Email
VITE_EMAILJS_TEMPLATE_STUDENT=template_student_welcome

# Template ID for Admin Notification Alert (Optional)
VITE_EMAILJS_TEMPLATE_ADMIN=template_admin_alert

# Public Key (from EmailJS -> Account -> Public Key)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Admin Email for Alerts & Student Inquiries
VITE_ADMIN_NOTIFICATION_EMAIL=support@aronlabz.com
